NS_COOKIE=如果本地调试这里填你的cookie

# 除签到外的任务（评论、加鸡腿）总开关，默认 false 即只签到
# 设为 true 才会执行评论和加鸡腿，开启前建议先改 randomInputStr 里的随机词
NS_EXTRA_TASKS=false

# DeepFlood 子站 cookie（可选，配置后两站顺序签到，中间自动随机延迟）
DEEPFLOOD_COOKIE=

# linux.sb（烧饼社区）签到 cookie（可选，配置后 NodeSeek、DeepFlood 完成后追加签到）
# 多账号用 & 分隔（cookie1&cookie2），依次签到、单账号失败不中断
LINUXSB_COOKIE=

# linux.sb 账号密码兜底登录（可选）：cookie 缺失或失效时自动浏览器登录，
# 实现"cookie 优先、失效自动重登"。格式为 JSON：
# LINUXSB_ACCOUNT={"username":"你的用户名","password":"你的密码"}
LINUXSB_ACCOUNT=

# 多站签到间随机延迟范围（秒，默认 60-180）
SITE_GAP_MIN=60
SITE_GAP_MAX=180

# ============================================================
# 通知渠道配置：按需填写，留空即跳过该渠道
# 全部渠道清单与获取方式见仓库根目录 README「通知渠道」
# ============================================================

# Telegram Bot 推送
TG_BOT_TOKEN=
TG_USER_ID=
# 可选：自建反代地址与 HTTP 代理
TG_API_HOST=
TG_PROXY=

# 飞书群机器人（Webhook 完整地址或纯 key 均可）
FEISHU_WEBHOOK=

# 钉钉群机器人（完整地址或纯 access_token 均可）
DINGTALK_WEBHOOK=
# 安全设置选「加签」时填写密钥
DINGTALK_SECRET=

# 企业微信群机器人（最简单，推荐）
WECOM_WEBHOOK=

# 企业微信自建应用推送
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENTID=
# 可选：接收成员，默认 @all
WECOM_TOUSER=

# Bark（iOS 推送，完整地址 https://api.day.app/设备Key 或纯设备 Key）
BARK_URL=

# Server酱（Turbo 与 Server酱³ 的 Key 均可，自动识别）
SERVERCHAN_KEY=

# PushPlus
PUSHPLUS_TOKEN=
# 可选：群组推送 Topic
PUSHPLUS_TOPIC=

# ntfy
NTFY_TOPIC=
# 可选：自建实例地址与消息优先级（默认 3）
NTFY_URL=
NTFY_PRIORITY=

# Gotify（自建服务）
GOTIFY_URL=
GOTIFY_TOKEN=
# 可选：消息优先级（默认 3）
GOTIFY_PRIORITY=
